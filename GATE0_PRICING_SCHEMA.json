{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcg-mas/schemas/gate0_pricing_schema.json",
  "title": "PCG-MAS Provider Pricing Manifest Schema",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_timestamp_utc",
    "currency",
    "providers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["v3.0-gate0-pricing"]
    },
    "snapshot_timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "currency": {
      "type": "string",
      "enum": ["USD"]
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "model_id",
          "input_per_1k_usd",
          "output_per_1k_usd"
        ],
        "properties": {
          "model_id": {"type": "string"},
          "input_per_1k_usd": {"type": "number", "minimum": 0.0},
          "cached_input_per_1k_usd": {"type": ["number", "null"], "minimum": 0.0},
          "reasoning_per_1k_usd": {"type": ["number", "null"], "minimum": 0.0},
          "output_per_1k_usd": {"type": "number", "minimum": 0.0}
        }
      }
    }
  }
}
