.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
.venv-*/
venv/
env/
envs/
ENV/
.venvs/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
.cache/
.hypothesis/

# OS / IDE clutter
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
*.swp
*.swo
*~
*.log

# Secrets — never commit
.env
.env.*
!.env.example
.secrets/
.env.secrets
*.secrets
*.pem
*.key

# Node modules
node_modules/

# Local workspace absolute exclusions (root level only)
/manuscript/
/Bucket_2/
/INTERNAL_ONLY/
/external_baselines/
/models/

# Local temporary scratch directories (root level only)
/scratch/
/runs/
/tmp/

# Legacy results and artifacts (root level only)
/results/
/artifacts/

# Never ignore sealed reproducibility assets
!/reproducibility/**
